{
  "schemaVersion": 2,
  "distribution": {
    "root": "tools/gotots"
  },
  "source": {
    "root": "vendor/typescript-go",
    "package": "./cmd/tsgo",
    "mode": "main"
  },
  "go": {
    "goos": "linux",
    "goarch": "amd64",
    "cgo": false,
    "tags": ["noasm"]
  },
  "semantics": {
    "integers": "fixed64-bigint",
    "evaluationOrder": "direct"
  },
  "providers": {
    "standardLibrary": true,
    "externals": true
  },
  "implementations": {
    "bundles": [
      "implementations/fswatch/contract.json",
      "implementations/x-sys-unix/contract.json",
      "implementations/xxh3/contract.json"
    ]
  },
  "output": {
    "directory": ".temp/generated"
  }
}
